// © MarkTaylor
// Capital Flow Regime v5.0
// A daily risk regime with explicit, tested rules:
//   RISK-ON   enter when the daily close is above its 50-day average AND the macro capital flow
//             score (DXY, VIX, Gold, US10Y on 1D + 1W) is above the veto level (-0.2)
//   RISK-OFF  exit when the daily close falls below its 50-day average
//   VETO      the trend is up but macro capital flow is too negative to enter
// Lab test (BTC/ETH/SOL daily, 2019-2026, long-only, fees): the macro veto improved Sharpe on all
// three assets and cut BTC's max drawdown from 56% to 42% versus the trend rule alone. It gives up
// some upside in strong bull years - it is a risk filter, not a return booster.
// Every input is read on the daily/weekly timeframe from closed bars only, so nothing repaints and
// the result is the same on any chart timeframe.
// Backtest version: run it on a DAILY chart; fills at the next daily open.

//@version=6
strategy("Capital Flow Regime Strategy [v5.0]", shorttitle="CF Regime Strat v5", overlay=true,
     initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=95,
     commission_type=strategy.commission.percent, commission_value=0.05, slippage=2,
     process_orders_on_close=false, calc_on_every_tick=false)

// ═══════════════════════════════════════════════════════════════════════════════
// INPUTS
// ═══════════════════════════════════════════════════════════════════════════════

marketInput = input.string("Auto", "Market", options=["Auto", "Crypto", "Equities", "Metals", "Forex", "Custom"], group="Market",
     tooltip="Auto picks the macro basket from the chart's instrument.\nCrypto: DXY, VIX, Gold, US10Y\nEquities: DXY, VIX, US10Y, HYG\nMetals: DXY, US10Y, VIX, SPX\nForex: US10Y, VIX, SPX, Gold\nCustom: the 4 symbols below (all count inverted: rising = risk-off)\nOnly Crypto has been backtested")


cust_1 = input.symbol("TVC:DXY", "Macro 1", group="Market - Custom Symbols")
cust_2 = input.symbol("TVC:VIX", "Macro 2", group="Market - Custom Symbols")
cust_3 = input.symbol("OANDA:XAUUSD", "Macro 3", group="Market - Custom Symbols")
cust_4 = input.symbol("TVC:US10Y", "Macro 4", group="Market - Custom Symbols")

mktTick = str.upper(syminfo.ticker)
isMetalSym = str.contains(mktTick, "XAU") or str.contains(mktTick, "XAG") or str.contains(mktTick, "GOLD") or str.contains(mktTick, "SILVER") or mktTick == "GLD" or mktTick == "SLV" or ((str.startswith(mktTick, "GC") or str.startswith(mktTick, "SI") or str.startswith(mktTick, "MGC")) and str.contains(mktTick, "!"))
autoMarket = isMetalSym ? "Metals" : syminfo.type == "crypto" ? "Crypto" : syminfo.type == "forex" ? "Forex" : "Equities"
market = marketInput == "Auto" ? autoMarket : marketInput

fxBase = syminfo.basecurrency
fxQuote = syminfo.currency
usdBase = fxBase == "USD"

src_dxy = switch market
    "Equities" => "TVC:DXY"
    "Metals" => "TVC:DXY"
    "Forex" => "TVC:US10Y"
    "Custom" => cust_1
    => "TVC:DXY"
src_vix = switch market
    "Metals" => "TVC:US10Y"
    "Forex" => "TVC:VIX"
    "Custom" => cust_2
    => "TVC:VIX"
src_gold = switch market
    "Equities" => "TVC:US10Y"
    "Metals" => "TVC:VIX"
    "Forex" => "SP:SPX"
    "Custom" => cust_3
    => "OANDA:XAUUSD"
src_yields = switch market
    "Equities" => "AMEX:HYG"
    "Metals" => "SP:SPX"
    "Forex" => "OANDA:XAUUSD"
    "Custom" => cust_4
    => "TVC:US10Y"

// true = the input rising is BEARISH for this instrument
inv_1 = market == "Forex" ? not usdBase : true                 // DXY / US10Y: strong dollar or yields = headwind
inv_2 = true                                                     // VIX (Metals: US10Y)
inv_3 = market == "Metals" ? false : market == "Forex" ? false : true   // Metals: VIX up = safe-haven bid; Forex: SPX up = risk-on
inv_4 = market == "Equities" ? false : market == "Forex" ? usdBase : true // Equities: HYG up = credit risk-on; Forex: gold up = weak dollar

// Panel labels
lbl_1 = market == "Forex" ? "US10Y" : "DXY"
lbl_2 = market == "Metals" ? "US10Y" : "VIX"
lbl_3 = market == "Equities" ? "US10Y" : market == "Metals" ? "VIX" : market == "Forex" ? "SPX" : "GOLD"
lbl_4 = market == "Equities" ? "HYG" : market == "Metals" ? "SPX" : market == "Forex" ? "GOLD" : "US10Y"

trendLen = input.int(50, "Trend Average (days)", minval=10, maxval=200, group="Regime",
     tooltip="Daily close vs its simple moving average. 30-60 tested well; 50 is the default")
vetoLevel = input.float(-0.2, "Macro Veto Level", minval=-1.0, maxval=0.5, step=0.05, group="Regime",
     tooltip="Entries are blocked while the macro score is at or below this level. -0.1 to -0.4 tested well")
flowLength = input.int(14, "Flow Length", minval=5, maxval=50, group="Regime",
     tooltip="Each macro input's flow = EMA of its rate of change over this many daily/weekly bars")
flowThreshold = input.float(0.5, "Flow Threshold (%)", minval=0.1, maxval=3.0, step=0.1, group="Regime",
     tooltip="A macro input counts as moving when its flow is beyond +/- this %")

showTrendLine = input.bool(true, "Show 50-Day Average", group="Display")
showBackground = input.bool(true, "Tint Background by Regime", group="Display")
bgStrength = input.int(90, "Background Transparency", minval=50, maxval=98, group="Display")
showMarks = input.bool(true, "Show Regime Change Labels", group="Display")
showPanel = input.bool(true, "Show Panel", group="Display")
panelPos = input.string("Top Right", "Panel Position", options=["Top Right", "Bottom Right", "Top Left", "Bottom Left"], group="Display")
colOn = input.color(#26A69A, "Risk-On", group="Display")
colVeto = input.color(#FFB74D, "Macro Veto", group="Display")
colOff = input.color(#EF5350, "Risk-Off", group="Display")

// ═══════════════════════════════════════════════════════════════════════════════
// DATA - daily / weekly, closed bars only
// ═══════════════════════════════════════════════════════════════════════════════

// Pure function of its arguments: nothing in here depends on the chart or requested timeframe
macroFlow(simple int len) =>
    ta.ema(ta.roc(close, len), len)

flowSignal(float f, float th) =>
    na(f) ? 0.0 : f > th ? 1.0 : f < -th ? -1.0 : 0.0

// Daily (weight 1) + weekly (weight 2) read, signed so that + = supportive for this instrument
macroRead(simple string sym, bool inverted) =>
    fd = request.security(sym, "1D", macroFlow(flowLength)[1], lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)
    fw = request.security(sym, "1W", macroFlow(flowLength)[1], lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)
    s = (flowSignal(fd, flowThreshold) + 2.0 * flowSignal(fw, flowThreshold)) / 3.0
    [inverted ? -s : s, fd, fw]

[m1, m1d, m1w] = macroRead(src_dxy, inv_1)
[m2, m2d, m2w] = macroRead(src_vix, inv_2)
[m3, m3d, m3w] = macroRead(src_gold, inv_3)
[m4, m4d, m4w] = macroRead(src_yields, inv_4)
macroScore = (m1 + m2 + m3 + m4) / 4.0

// Daily trend. On a daily chart the current bar is used (decisions at the daily close);
// on other timeframes the last CLOSED daily bar is used.
isDailyChart = timeframe.isdaily and timeframe.multiplier == 1
[dClosePrev, dAvgPrev] = request.security(syminfo.tickerid, "1D", [close[1], ta.sma(close, trendLen)[1]], lookahead=barmerge.lookahead_on)
dAvgChart = ta.sma(close, trendLen)
dClose = isDailyChart ? close : dClosePrev
dAvg = isDailyChart ? dAvgChart : dAvgPrev
trendUp = dClose > dAvg
trendDown = dClose < dAvg

// ═══════════════════════════════════════════════════════════════════════════════
// REGIME - the tested rule, as a state machine
// ═══════════════════════════════════════════════════════════════════════════════

var bool riskOn = false
bool turnedOn = false
bool turnedOff = false
newDay = isDailyChart or ta.change(time("1D")) != 0
if newDay and not na(dAvg)
    if not riskOn and trendUp and macroScore > vetoLevel
        riskOn := true
        turnedOn := true
    else if riskOn and trendDown
        riskOn := false
        turnedOff := true

vetoed = not riskOn and trendUp and macroScore <= vetoLevel
state = riskOn ? 1 : vetoed ? 0 : -1

// ═══════════════════════════════════════════════════════════════════════════════
// VISUALS
// ═══════════════════════════════════════════════════════════════════════════════

stateCol = state == 1 ? colOn : state == 0 ? colVeto : colOff
plot(showTrendLine ? dAvg : na, "50-Day Average", color=color.new(stateCol, 0), linewidth=2, style=plot.style_linebr)
bgcolor(showBackground ? color.new(stateCol, bgStrength) : na, title="Regime Background")
plotshape(showMarks and turnedOn, "Risk-On", shape.labelup, location.belowbar, color.new(colOn, 0), text="RISK-ON", textcolor=color.white, size=size.small)
plotshape(showMarks and turnedOff, "Risk-Off", shape.labeldown, location.abovebar, color.new(colOff, 0), text="RISK-OFF", textcolor=color.white, size=size.small)

// Data window / alert values
plot(macroScore, "Macro Score", display=display.data_window)
plot(state, "Regime State (1 on, 0 veto, -1 off)", display=display.data_window)

arrow(float s) =>
    s > 0.05 ? "▲" : s < -0.05 ? "▼" : "•"
readCol(float s) =>
    s > 0.05 ? colOn : s < -0.05 ? colOff : #B2B5BE

var table panel = table.new(panelPos == "Top Right" ? position.top_right : panelPos == "Bottom Right" ? position.bottom_right : panelPos == "Top Left" ? position.top_left : position.bottom_left,
     2, 8, bgcolor=color.new(#131722, 5), frame_color=color.new(#363A45, 0), frame_width=1, border_color=color.new(#363A45, 0), border_width=1)
if showPanel and barstate.islast
    txt = state == 1 ? "RISK-ON" : state == 0 ? "MACRO VETO" : "RISK-OFF"
    table.cell(panel, 0, 0, "CAPITAL FLOW v5", text_color=#E6E9EF, text_size=size.small, text_halign=text.align_left)
    table.cell(panel, 1, 0, txt, text_color=color.white, bgcolor=color.new(stateCol, 15), text_size=size.small)
    dist = dAvg > 0 ? (dClose / dAvg - 1) * 100 : 0.0
    table.cell(panel, 0, 1, "Trend (vs " + str.tostring(trendLen) + "D avg)", text_color=#B2B5BE, text_size=size.small, text_halign=text.align_left)
    table.cell(panel, 1, 1, (dist >= 0 ? "+" : "") + str.tostring(dist, "0.0") + "%", text_color=trendUp ? colOn : colOff, text_size=size.small)
    table.cell(panel, 0, 2, "Macro score (veto " + str.tostring(vetoLevel, "0.00") + ")", text_color=#B2B5BE, text_size=size.small, text_halign=text.align_left)
    table.cell(panel, 1, 2, (macroScore >= 0 ? "+" : "") + str.tostring(macroScore, "0.00"), text_color=macroScore > vetoLevel ? colOn : colOff, text_size=size.small)
    table.cell(panel, 0, 3, lbl_1 + "  D/W", text_color=#B2B5BE, text_size=size.small, text_halign=text.align_left)
    table.cell(panel, 1, 3, arrow(m1), text_color=readCol(m1), text_size=size.small)
    table.cell(panel, 0, 4, lbl_2 + "  D/W", text_color=#B2B5BE, text_size=size.small, text_halign=text.align_left)
    table.cell(panel, 1, 4, arrow(m2), text_color=readCol(m2), text_size=size.small)
    table.cell(panel, 0, 5, lbl_3 + "  D/W", text_color=#B2B5BE, text_size=size.small, text_halign=text.align_left)
    table.cell(panel, 1, 5, arrow(m3), text_color=readCol(m3), text_size=size.small)
    table.cell(panel, 0, 6, lbl_4 + "  D/W", text_color=#B2B5BE, text_size=size.small, text_halign=text.align_left)
    table.cell(panel, 1, 6, arrow(m4), text_color=readCol(m4), text_size=size.small)
    table.cell(panel, 0, 7, "Market: " + market, text_color=#787B86, text_size=size.tiny, text_halign=text.align_left)
    table.cell(panel, 1, 7, "daily regime", text_color=#787B86, text_size=size.tiny)

// ═══════════════════════════════════════════════════════════════════════════════
// BACKTEST (long-only: in while Risk-On)
// ═══════════════════════════════════════════════════════════════════════════════

btStart = input.time(timestamp("2019-01-01T00:00:00"), "Backtest From", group="Backtest")
inWindow = time >= btStart
if inWindow and riskOn and strategy.position_size == 0
    strategy.entry("Risk-On", strategy.long)
if strategy.position_size > 0 and not riskOn
    strategy.close("Risk-On", comment="Risk-Off")
