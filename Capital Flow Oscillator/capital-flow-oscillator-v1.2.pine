// Capital Flow Oscillator v1.2
// Keltner-based oscillator - bands breathe with volatility

//@version=6
indicator("Capital Flow Oscillator [v1.2]", shorttitle="CF Osc", overlay=false, max_labels_count=500)

// ═══════════════════════════════════════════════════════════════════════════════
// INPUTS - MODE
// ═══════════════════════════════════════════════════════════════════════════════

tradingModeInput = input.string("Auto", "Trading Mode", 
     options=["Auto", "Swing", "Intraday", "Scalp"], 
     group="Mode",
     tooltip="Auto: Detects chart timeframe automatically\nSwing: 4H/D/W data, slower signals\nIntraday: 15m/1H/4H data, faster signals\nScalp: 5m/15m/1H data, fastest signals")

autoDetectedMode = timeframe.in_seconds() <= 900 ? "Scalp" : timeframe.in_seconds() <= 14400 ? "Intraday" : "Swing"
tradingMode = tradingModeInput == "Auto" ? autoDetectedMode : tradingModeInput

// ═══════════════════════════════════════════════════════════════════════════════
// INPUTS - DATA SOURCES
// ═══════════════════════════════════════════════════════════════════════════════

src_dxy = input.symbol("TVC:DXY", "DXY (Dollar Index)", group="Data Sources - Macro")
src_vix = input.symbol("TVC:VIX", "VIX (Volatility)", group="Data Sources - Macro")
src_gold = input.symbol("OANDA:XAUUSD", "Gold", group="Data Sources - Macro")
src_yields = input.symbol("TVC:US10Y", "US 10Y Yields", group="Data Sources - Macro")

src_btc = input.symbol("BINANCE:BTCUSDT", "BTC", group="Data Sources - Crypto")
src_eth = input.symbol("BINANCE:ETHUSDT", "ETH", group="Data Sources - Crypto")

src_btcd = input.symbol("CRYPTOCAP:BTC.D", "BTC Dominance", group="Data Sources - Sectors")
src_total3 = input.symbol("CRYPTOCAP:TOTAL3", "TOTAL3 (Alt Cap)", group="Data Sources - Sectors")

// ═══════════════════════════════════════════════════════════════════════════════
// INPUTS - KELTNER CHANNEL (Matches Overlay)
// ═══════════════════════════════════════════════════════════════════════════════

keltnerLength = input.int(20, "Keltner Length", minval=5, maxval=50, group="Keltner Channel")
keltnerMult = input.float(2.0, "Keltner Multiplier", minval=0.5, maxval=5.0, step=0.1, group="Keltner Channel")
showKeltnerLines = input.bool(true, "Show Keltner Lines", group="Keltner Channel")
keltnerLineWidth = input.int(1, "Keltner Line Width", minval=1, maxval=3, group="Keltner Channel")

// ═══════════════════════════════════════════════════════════════════════════════
// INPUTS - CLOUD VISUAL SETTINGS
// ═══════════════════════════════════════════════════════════════════════════════

cloudStyle = input.string("Gradient", "Cloud Style", options=["Solid", "Gradient", "Glow"], group="Visual - Cloud",
     tooltip="Solid: Single color\nGradient: Intensity based on conviction\nGlow: Brighter at edges")
baseTransparency = input.int(50, "Cloud Base Transparency", minval=20, maxval=90, group="Visual - Cloud")
showCloudEdge = input.bool(true, "Show Cloud Edge Line", group="Visual - Cloud")
edgeLineWidth = input.int(2, "Edge Line Width", minval=1, maxval=4, group="Visual - Cloud")

// Signal markers
showFlipDots = input.bool(true, "Show Flip Dots (Basis Cross)", group="Visual - Signals")
showConfluenceDots = input.bool(true, "Show Confluence Dots", group="Visual - Signals")
showDivergenceMarkers = input.bool(true, "Show Divergence Markers", group="Visual - Signals")
showBandTouch = input.bool(true, "Highlight Band Touch (Entry Zone)", group="Visual - Signals",
     tooltip="Highlights when capital flow reaches the Keltner bands - potential entry zone per Cloud Edge strategy")

// ═══════════════════════════════════════════════════════════════════════════════
// INPUTS - CALCULATION SETTINGS
// ═══════════════════════════════════════════════════════════════════════════════

flowLength = input.int(14, "Flow Calculation Length", minval=5, maxval=50, group="Settings")
lookbackMode = input.string("Auto", "Lookback Mode", options=["Auto", "Manual"], group="Settings")
lookbackManual = input.int(100, "Manual Lookback", minval=20, maxval=500, group="Settings")
smoothingMode = input.string("Auto", "Smoothing", options=["Auto", "Manual"], group="Settings")
smoothingManual = input.int(5, "Manual Smoothing", minval=1, maxval=20, group="Settings")

// ═══════════════════════════════════════════════════════════════════════════════
// INPUTS - ALERTS
// ═══════════════════════════════════════════════════════════════════════════════

alertCooldown = input.int(5, "Alert Cooldown (bars)", minval=1, maxval=50, group="Alerts")
alertFlip = input.bool(true, "Flip Alerts (Basis Cross)", group="Alerts")
alertBandTouch = input.bool(true, "Band Touch Alerts (Entry Zone)", group="Alerts")
alertDivergence = input.bool(false, "Divergence Alerts", group="Alerts")

// ═══════════════════════════════════════════════════════════════════════════════
// COLORS
// ═══════════════════════════════════════════════════════════════════════════════

// Cloud colors - matching overlay indicator
cloud_bull = #00ffaa
cloud_bear = #ff4466
cloud_neutral = #888888

// Edge line colors
edge_bull = #00ffcc
edge_bear = #ff6688

// Keltner structure colors
keltner_basis_color = #ECEFF1      // Bright white for basis
keltner_band_color = #ffcc00       // Gold for bands (matches overlay)

// Signal colors
dot_bull = #00ffaa
dot_bear = #ff4466
dot_confluence = #FFD700
dot_divergence = #FF9800
band_touch_color = #00E5FF         // Cyan highlight for band touch

// ═══════════════════════════════════════════════════════════════════════════════
// TIMEFRAME SELECTION BY MODE
// ═══════════════════════════════════════════════════════════════════════════════

tf1 = switch tradingMode
    "Swing" => "240"
    "Intraday" => "15"
    "Scalp" => "5"
    => "240"

tf2 = switch tradingMode
    "Swing" => "1D"
    "Intraday" => "60"
    "Scalp" => "15"
    => "1D"

tf3 = switch tradingMode
    "Swing" => "1W"
    "Intraday" => "240"
    "Scalp" => "60"
    => "1W"

tf1_weight = 1.0
tf2_weight = 2.0
tf3_weight = 3.0
totalTfWeight = tf1_weight + tf2_weight + tf3_weight

// ═══════════════════════════════════════════════════════════════════════════════
// AUTO LOOKBACK & SMOOTHING
// ═══════════════════════════════════════════════════════════════════════════════

autoLookback = switch tradingMode
    "Swing" => timeframe.in_seconds() <= 3600 ? 200 : timeframe.in_seconds() <= 14400 ? 100 : timeframe.in_seconds() <= 86400 ? 50 : 25
    "Intraday" => timeframe.in_seconds() <= 900 ? 400 : timeframe.in_seconds() <= 3600 ? 200 : 100
    "Scalp" => timeframe.in_seconds() <= 300 ? 600 : timeframe.in_seconds() <= 900 ? 400 : 200
    => 100

lookback = lookbackMode == "Auto" ? autoLookback : lookbackManual

baseSmoothing = switch tradingMode
    "Swing" => timeframe.in_seconds() < 3600 ? 8 : timeframe.in_seconds() < 14400 ? 5 : timeframe.in_seconds() < 86400 ? 3 : 1
    "Intraday" => timeframe.in_seconds() < 900 ? 5 : timeframe.in_seconds() < 3600 ? 3 : 2
    "Scalp" => timeframe.in_seconds() < 300 ? 3 : 2
    => 3

smoothing = smoothingMode == "Auto" ? baseSmoothing : smoothingManual

// ═══════════════════════════════════════════════════════════════════════════════
// HELPER FUNCTIONS
// ═══════════════════════════════════════════════════════════════════════════════

calcFlow(float src, int len) =>
    roc = ta.roc(src, len)
    ta.ema(roc, len)

getSignal(float flow, bool invert) =>
    threshold = 0.5
    rawSignal = flow > threshold ? 1.0 : flow < -threshold ? -1.0 : 0.0
    invert ? -rawSignal : rawSignal

calcCorrelation(float signal, int len) =>
    signalThreshold = 0.3
    priceUp = close > close[1]
    signalBull = signal > signalThreshold
    signalBear = signal < -signalThreshold
    signalActive = math.abs(signal) > signalThreshold
    correctBull = signalBull and priceUp ? 1.0 : 0.0
    correctBear = signalBear and not priceUp ? 1.0 : 0.0
    correct = correctBull + correctBear
    active = signalActive ? 1.0 : 0.0
    correctSum = math.sum(correct, len)
    activeSum = math.sum(active, len)
    activeSum > 10 ? (correctSum / activeSum) * 100 : 50.0

calcEdge(float corr) =>
    math.abs(corr - 50) / 50

calcMultiplier(float corr) =>
    corr >= 50 ? 1.0 : -1.0

calcWeight(float corr) =>
    0.2 + 0.8 * calcEdge(corr)

// ═══════════════════════════════════════════════════════════════════════════════
// ASSET TYPE DETECTION
// ═══════════════════════════════════════════════════════════════════════════════

tickerUpper = str.upper(syminfo.ticker)
isBTC = str.contains(tickerUpper, "BTC") and not str.contains(tickerUpper, "BTC.D")
isETH = str.contains(tickerUpper, "ETH")
isMajor = isBTC or isETH
isAlt = not isMajor

macroMult = isBTC ? 1.2 : isETH ? 1.1 : 0.9
cryptoMult = isBTC ? 1.0 : isETH ? 1.1 : 1.0
sectorMult = isBTC ? 0.8 : isETH ? 1.0 : 1.3

// ═══════════════════════════════════════════════════════════════════════════════
// DATA RETRIEVAL
// ═══════════════════════════════════════════════════════════════════════════════

// MACRO
dxy_tf1 = request.security(src_dxy, tf1, calcFlow(close, flowLength), lookahead=barmerge.lookahead_off)
dxy_tf2 = request.security(src_dxy, tf2, calcFlow(close, flowLength), lookahead=barmerge.lookahead_off)
dxy_tf3 = request.security(src_dxy, tf3, calcFlow(close, flowLength), lookahead=barmerge.lookahead_off)

vix_tf1 = request.security(src_vix, tf1, calcFlow(close, flowLength), lookahead=barmerge.lookahead_off)
vix_tf2 = request.security(src_vix, tf2, calcFlow(close, flowLength), lookahead=barmerge.lookahead_off)
vix_tf3 = request.security(src_vix, tf3, calcFlow(close, flowLength), lookahead=barmerge.lookahead_off)

gold_tf1 = request.security(src_gold, tf1, calcFlow(close, flowLength), lookahead=barmerge.lookahead_off)
gold_tf2 = request.security(src_gold, tf2, calcFlow(close, flowLength), lookahead=barmerge.lookahead_off)
gold_tf3 = request.security(src_gold, tf3, calcFlow(close, flowLength), lookahead=barmerge.lookahead_off)

yields_tf1 = request.security(src_yields, tf1, calcFlow(close, flowLength), lookahead=barmerge.lookahead_off)
yields_tf2 = request.security(src_yields, tf2, calcFlow(close, flowLength), lookahead=barmerge.lookahead_off)
yields_tf3 = request.security(src_yields, tf3, calcFlow(close, flowLength), lookahead=barmerge.lookahead_off)

// CRYPTO
btc_tf1 = request.security(src_btc, tf1, calcFlow(close, flowLength), lookahead=barmerge.lookahead_off)
btc_tf2 = request.security(src_btc, tf2, calcFlow(close, flowLength), lookahead=barmerge.lookahead_off)
btc_tf3 = request.security(src_btc, tf3, calcFlow(close, flowLength), lookahead=barmerge.lookahead_off)

eth_tf1 = request.security(src_eth, tf1, calcFlow(close, flowLength), lookahead=barmerge.lookahead_off)
eth_tf2 = request.security(src_eth, tf2, calcFlow(close, flowLength), lookahead=barmerge.lookahead_off)
eth_tf3 = request.security(src_eth, tf3, calcFlow(close, flowLength), lookahead=barmerge.lookahead_off)

// SECTORS
btcd_tf2 = request.security(src_btcd, tf2, calcFlow(close, flowLength), lookahead=barmerge.lookahead_off)
total3_tf2 = request.security(src_total3, tf2, calcFlow(close, flowLength), lookahead=barmerge.lookahead_off)

// ═══════════════════════════════════════════════════════════════════════════════
// SIGNAL GENERATION
// ═══════════════════════════════════════════════════════════════════════════════

// MACRO - inverted (risk-off assets)
sig_dxy_1 = getSignal(dxy_tf1, true)
sig_dxy_2 = getSignal(dxy_tf2, true)
sig_dxy_3 = getSignal(dxy_tf3, true)

sig_vix_1 = getSignal(vix_tf1, true)
sig_vix_2 = getSignal(vix_tf2, true)
sig_vix_3 = getSignal(vix_tf3, true)

sig_gold_1 = getSignal(gold_tf1, true)
sig_gold_2 = getSignal(gold_tf2, true)
sig_gold_3 = getSignal(gold_tf3, true)

sig_yields_1 = getSignal(yields_tf1, true)
sig_yields_2 = getSignal(yields_tf2, true)
sig_yields_3 = getSignal(yields_tf3, true)

// CRYPTO - direct (risk-on assets)
sig_btc_1 = getSignal(btc_tf1, false)
sig_btc_2 = getSignal(btc_tf2, false)
sig_btc_3 = getSignal(btc_tf3, false)

sig_eth_1 = getSignal(eth_tf1, false)
sig_eth_2 = getSignal(eth_tf2, false)
sig_eth_3 = getSignal(eth_tf3, false)

// SECTORS
sig_btcd = getSignal(btcd_tf2, true)
sig_total3 = getSignal(total3_tf2, false)

// Combined multi-TF signals
sig_dxy = (sig_dxy_1 * tf1_weight + sig_dxy_2 * tf2_weight + sig_dxy_3 * tf3_weight) / totalTfWeight
sig_vix = (sig_vix_1 * tf1_weight + sig_vix_2 * tf2_weight + sig_vix_3 * tf3_weight) / totalTfWeight
sig_gold = (sig_gold_1 * tf1_weight + sig_gold_2 * tf2_weight + sig_gold_3 * tf3_weight) / totalTfWeight
sig_yields = (sig_yields_1 * tf1_weight + sig_yields_2 * tf2_weight + sig_yields_3 * tf3_weight) / totalTfWeight

sig_btc = (sig_btc_1 * tf1_weight + sig_btc_2 * tf2_weight + sig_btc_3 * tf3_weight) / totalTfWeight
sig_eth = (sig_eth_1 * tf1_weight + sig_eth_2 * tf2_weight + sig_eth_3 * tf3_weight) / totalTfWeight

// ═══════════════════════════════════════════════════════════════════════════════
// CORRELATION & WEIGHTING
// ═══════════════════════════════════════════════════════════════════════════════

corr_dxy = calcCorrelation(sig_dxy, lookback)
corr_vix = calcCorrelation(sig_vix, lookback)
corr_gold = calcCorrelation(sig_gold, lookback)
corr_yields = calcCorrelation(sig_yields, lookback)
corr_btc = calcCorrelation(sig_btc, lookback)
corr_eth = calcCorrelation(sig_eth, lookback)
corr_btcd = calcCorrelation(sig_btcd, lookback)
corr_total3 = calcCorrelation(sig_total3, lookback)

w_dxy = calcWeight(corr_dxy)
w_vix = calcWeight(corr_vix)
w_gold = calcWeight(corr_gold)
w_yields = calcWeight(corr_yields)
w_btc = calcWeight(corr_btc)
w_eth = calcWeight(corr_eth)
w_btcd = calcWeight(corr_btcd)
w_total3 = calcWeight(corr_total3)

m_dxy = calcMultiplier(corr_dxy)
m_vix = calcMultiplier(corr_vix)
m_gold = calcMultiplier(corr_gold)
m_yields = calcMultiplier(corr_yields)
m_btc = calcMultiplier(corr_btc)
m_eth = calcMultiplier(corr_eth)
m_btcd = calcMultiplier(corr_btcd)
m_total3 = calcMultiplier(corr_total3)

// ═══════════════════════════════════════════════════════════════════════════════
// CONFLUENCE CALCULATION
// ═══════════════════════════════════════════════════════════════════════════════

eff_dxy = sig_dxy * m_dxy
eff_vix = sig_vix * m_vix
eff_gold = sig_gold * m_gold
eff_yields = sig_yields * m_yields
eff_btc = sig_btc * m_btc
eff_eth = sig_eth * m_eth
eff_btcd = sig_btcd * m_btcd
eff_total3 = sig_total3 * m_total3

macroBull = (eff_dxy > 0 ? 1 : 0) + (eff_vix > 0 ? 1 : 0) + (eff_gold > 0 ? 1 : 0) + (eff_yields > 0 ? 1 : 0)
cryptoBull = (eff_btc > 0 ? 1 : 0) + (eff_eth > 0 ? 1 : 0)
sectorBull = (eff_btcd > 0 ? 1 : 0) + (eff_total3 > 0 ? 1 : 0)
bullCount = macroBull + cryptoBull + sectorBull

macroBear = (eff_dxy < 0 ? 1 : 0) + (eff_vix < 0 ? 1 : 0) + (eff_gold < 0 ? 1 : 0) + (eff_yields < 0 ? 1 : 0)
cryptoBear = (eff_btc < 0 ? 1 : 0) + (eff_eth < 0 ? 1 : 0)
sectorBear = (eff_btcd < 0 ? 1 : 0) + (eff_total3 < 0 ? 1 : 0)
bearCount = macroBear + cryptoBear + sectorBear

fullBullConfluence = bullCount == 8
fullBearConfluence = bearCount == 8
highConfluence = bullCount >= 6 or bearCount >= 6

// ═══════════════════════════════════════════════════════════════════════════════
// FINAL SCORE CALCULATION
// ═══════════════════════════════════════════════════════════════════════════════

macroScore = (sig_dxy * m_dxy * w_dxy + sig_vix * m_vix * w_vix + 
              sig_gold * m_gold * w_gold + sig_yields * m_yields * w_yields) * macroMult
macroWeights = (w_dxy + w_vix + w_gold + w_yields) * macroMult

cryptoScore = (sig_btc * m_btc * w_btc + sig_eth * m_eth * w_eth) * cryptoMult
cryptoWeights = (w_btc + w_eth) * cryptoMult

sectorScore = (sig_btcd * m_btcd * w_btcd + sig_total3 * m_total3 * w_total3) * sectorMult
sectorWeights = (w_btcd + w_total3) * sectorMult

totalScore = macroScore + cryptoScore + sectorScore
totalWeights = macroWeights + cryptoWeights + sectorWeights

rawScore = totalWeights > 0.1 ? math.max(math.min(totalScore / totalWeights, 1.0), -1.0) : 0

// Apply smoothing
normalizedScore = smoothing > 1 ? ta.ema(rawScore, smoothing) : rawScore

// Conviction (0 to 1)
conviction = math.abs(normalizedScore)

// ═══════════════════════════════════════════════════════════════════════════════
// KELTNER CHANNEL CALCULATION (Dynamic Bands)
// ═══════════════════════════════════════════════════════════════════════════════

// Calculate ATR for dynamic band width
keltnerAtr = ta.atr(keltnerLength)
atrBaseline = ta.sma(keltnerAtr, 100)  // Long-term average for normalization

// Volatility ratio - how current ATR compares to baseline
volatilityRatio = atrBaseline > 0 ? keltnerAtr / atrBaseline : 1.0

// Dynamic band width: expands in high volatility, contracts in low volatility
// Base width is 70, scaled by volatility ratio (clamped to prevent extremes)
clampedVolRatio = math.max(0.5, math.min(volatilityRatio, 2.0))
dynamicBandWidth = 70 * clampedVolRatio

// The Keltner structure in oscillator space:
// Basis = 0 (always centered)
// Upper Band = +dynamicBandWidth (expands/contracts with ATR)
// Lower Band = -dynamicBandWidth

oscBasis = 0.0
oscUpperBand = dynamicBandWidth
oscLowerBand = -dynamicBandWidth

// ═══════════════════════════════════════════════════════════════════════════════
// CAPITAL FLOW WAVE (Scaled to Keltner Structure)
// ═══════════════════════════════════════════════════════════════════════════════

// Scale the capital flow score to fit within the dynamic Keltner bands
// At 100% conviction, wave touches the band
// At 0% conviction, wave is at basis
waveValue = normalizedScore * dynamicBandWidth

// ═══════════════════════════════════════════════════════════════════════════════
// SIGNAL DETECTION
// ═══════════════════════════════════════════════════════════════════════════════

// Basis cross (flip signal)
flipToBullish = waveValue > 0 and waveValue[1] <= 0
flipToBearish = waveValue < 0 and waveValue[1] >= 0

// Band touch detection (entry zone per Cloud Edge strategy)
// Wave reaches 70%+ of the band = at the "cloud edge"
bandTouchThreshold = 0.7
touchingUpperBand = waveValue >= oscUpperBand * bandTouchThreshold
touchingLowerBand = waveValue <= oscLowerBand * bandTouchThreshold

// First touch after flip (highest probability per strategy)
var bool wasAboveBasis = false
var bool wasBelowBasis = false

if flipToBullish
    wasAboveBasis := true
    wasBelowBasis := false
if flipToBearish
    wasAboveBasis := false
    wasBelowBasis := true

firstTouchUpper = touchingUpperBand and wasAboveBasis and not touchingUpperBand[1]
firstTouchLower = touchingLowerBand and wasBelowBasis and not touchingLowerBand[1]

// Full send = at or beyond the band
atUpperBand = waveValue >= oscUpperBand * 0.95
atLowerBand = waveValue <= oscLowerBand * 0.95

// Divergence detection
priceLowerLow = low < ta.lowest(low, 10)[1]
waveHigherLow = waveValue > ta.lowest(waveValue, 10)[1] + (dynamicBandWidth * 0.1)
bullishDivergence = priceLowerLow and waveHigherLow and waveValue < 0

priceHigherHigh = high > ta.highest(high, 10)[1]
waveLowerHigh = waveValue < ta.highest(waveValue, 10)[1] - (dynamicBandWidth * 0.1)
bearishDivergence = priceHigherHigh and waveLowerHigh and waveValue > 0

// ═══════════════════════════════════════════════════════════════════════════════
// CLOUD COLOR CALCULATION
// ═══════════════════════════════════════════════════════════════════════════════

getCloudTransparency(float conv, string style) =>
    if style == "Solid"
        baseTransparency
    else if style == "Gradient"
        int(baseTransparency - (conv * 40))
    else // Glow
        int(baseTransparency - (conv * conv * 50))

cloudTransp = getCloudTransparency(conviction, cloudStyle)

bullCloudColor = color.new(cloud_bull, cloudTransp)
bearCloudColor = color.new(cloud_bear, cloudTransp)

edgeColor = waveValue >= 0 ? edge_bull : edge_bear

// ═══════════════════════════════════════════════════════════════════════════════
// PLOTTING - KELTNER STRUCTURE (Dynamic Bands)
// ═══════════════════════════════════════════════════════════════════════════════

// Basis line (the equilibrium - center of Keltner)
basisPlot = plot(oscBasis, "Keltner Basis", color=showKeltnerLines ? keltner_basis_color : color.new(color.white, 100), linewidth=2)

// Upper band (dynamic - breathes with volatility)
upperBandPlot = plot(oscUpperBand, "Keltner Upper", color=showKeltnerLines ? keltner_band_color : color.new(color.white, 100), linewidth=keltnerLineWidth)

// Lower band (dynamic - breathes with volatility)
lowerBandPlot = plot(oscLowerBand, "Keltner Lower", color=showKeltnerLines ? keltner_band_color : color.new(color.white, 100), linewidth=keltnerLineWidth)

// ═══════════════════════════════════════════════════════════════════════════════
// PLOTTING - THE CLOUD (Capital Flow)
// ═══════════════════════════════════════════════════════════════════════════════

// Plot the wave
wavePlot = plot(waveValue, "Capital Flow Wave", color=color.new(color.white, 100), linewidth=1)
zeroPlot = plot(0, "Zero", color=color.new(color.white, 100), linewidth=1)

// Fill between wave and basis - THIS IS THE CLOUD
fill(wavePlot, basisPlot, waveValue >= 0 ? bullCloudColor : bearCloudColor, title="Capital Flow Cloud")

// Edge line on top of cloud
plot(showCloudEdge ? waveValue : na, "Cloud Edge", color=edgeColor, linewidth=edgeLineWidth)

// ═══════════════════════════════════════════════════════════════════════════════
// PLOTTING - BAND TOUCH HIGHLIGHTING (Entry Zones)
// ═══════════════════════════════════════════════════════════════════════════════

// Highlight when wave is in the "entry zone" near bands
bgcolor(showBandTouch and touchingUpperBand ? color.new(cloud_bull, 90) : na, title="Upper Band Zone")
bgcolor(showBandTouch and touchingLowerBand ? color.new(cloud_bear, 90) : na, title="Lower Band Zone")

// ═══════════════════════════════════════════════════════════════════════════════
// PLOTTING - SIGNAL MARKERS
// ═══════════════════════════════════════════════════════════════════════════════

// Flip dots at basis crossings
plotshape(showFlipDots and flipToBullish, "Bull Flip", shape.circle, location.absolute, dot_bull, size=size.small)
plotshape(showFlipDots and flipToBearish, "Bear Flip", shape.circle, location.absolute, dot_bear, size=size.small)

// Confluence dots
plotshape(showConfluenceDots and highConfluence and barstate.isconfirmed, "High Confluence", shape.diamond, location.absolute, dot_confluence, size=size.tiny)
plotshape(showConfluenceDots and fullBullConfluence, "Full Bull Confluence", shape.triangleup, location.absolute, #FFD700, size=size.small)
plotshape(showConfluenceDots and fullBearConfluence, "Full Bear Confluence", shape.triangledown, location.absolute, #FFD700, size=size.small)

// Band touch markers (entry signals)
plotshape(showBandTouch and firstTouchUpper, "First Touch Upper", shape.triangledown, location.top, band_touch_color, size=size.tiny, text="ENTRY")
plotshape(showBandTouch and firstTouchLower, "First Touch Lower", shape.triangleup, location.bottom, band_touch_color, size=size.tiny, text="ENTRY")

// At-band markers (full send)
plotshape(atUpperBand and not atUpperBand[1], "At Upper Band", shape.triangleup, location.absolute, cloud_bull, size=size.tiny)
plotshape(atLowerBand and not atLowerBand[1], "At Lower Band", shape.triangledown, location.absolute, cloud_bear, size=size.tiny)

// Divergence markers
plotshape(showDivergenceMarkers and bullishDivergence, "Bull Divergence", shape.labelup, location.bottom, dot_divergence, size=size.tiny, text="DIV", textcolor=color.white)
plotshape(showDivergenceMarkers and bearishDivergence, "Bear Divergence", shape.labeldown, location.top, dot_divergence, size=size.tiny, text="DIV", textcolor=color.white)

// ═══════════════════════════════════════════════════════════════════════════════
// INFO LABEL
// ═══════════════════════════════════════════════════════════════════════════════

var label infoLabel = na

if barstate.islast
    label.delete(infoLabel)
    
    scorePct = str.tostring(math.round(normalizedScore * 100)) + "%"
    confText = str.tostring(math.max(bullCount, bearCount)) + "/8"
    volText = str.tostring(math.round(volatilityRatio * 100)) + "% vol"
    
    stateText = atUpperBand ? "FULL SEND BULL" : 
                atLowerBand ? "FULL SEND BEAR" :
                touchingUpperBand ? "AT UPPER BAND" :
                touchingLowerBand ? "AT LOWER BAND" :
                waveValue > 0 ? "BULLISH" : 
                waveValue < 0 ? "BEARISH" : 
                "NEUTRAL"
    
    labelText = stateText + "\n" + scorePct + " | " + confText + " | " + volText
    
    labelColor = waveValue > oscUpperBand * 0.5 ? color.new(cloud_bull, 20) : 
                 waveValue < oscLowerBand * 0.5 ? color.new(cloud_bear, 20) : 
                 color.new(cloud_neutral, 20)
    
    infoLabel := label.new(bar_index + 3, waveValue, labelText, 
         xloc.bar_index, yloc.price, labelColor, 
         label.style_label_left, color.white, size.small)

// ═══════════════════════════════════════════════════════════════════════════════
// ALERTS
// ═══════════════════════════════════════════════════════════════════════════════

var int lastAlertBar = 0
canAlert = bar_index - lastAlertBar >= alertCooldown

if canAlert and (flipToBullish or flipToBearish or firstTouchUpper or firstTouchLower)
    lastAlertBar := bar_index

// Alert conditions
alertcondition(alertFlip and flipToBullish, title="Flip Bullish (Basis Cross)", 
     message="Capital Flow crossed above BASIS on {{ticker}} {{interval}} - Cloud now GREEN")
alertcondition(alertFlip and flipToBearish, title="Flip Bearish (Basis Cross)", 
     message="Capital Flow crossed below BASIS on {{ticker}} {{interval}} - Cloud now RED")
alertcondition(alertBandTouch and firstTouchUpper, title="Upper Band Touch (Entry Zone)", 
     message="Capital Flow reached UPPER BAND on {{ticker}} {{interval}} - Potential SHORT entry zone")
alertcondition(alertBandTouch and firstTouchLower, title="Lower Band Touch (Entry Zone)", 
     message="Capital Flow reached LOWER BAND on {{ticker}} {{interval}} - Potential LONG entry zone")
alertcondition(alertBandTouch and atUpperBand and not atUpperBand[1], title="At Upper Band (Full Send)", 
     message="Capital Flow at UPPER BAND on {{ticker}} {{interval}} - Maximum bullish conviction")
alertcondition(alertBandTouch and atLowerBand and not atLowerBand[1], title="At Lower Band (Full Send)", 
     message="Capital Flow at LOWER BAND on {{ticker}} {{interval}} - Maximum bearish conviction")
alertcondition(alertDivergence and bullishDivergence, title="Bull Divergence", 
     message="Bullish divergence detected on {{ticker}} {{interval}}")
alertcondition(alertDivergence and bearishDivergence, title="Bear Divergence", 
     message="Bearish divergence detected on {{ticker}} {{interval}}")

// ═══════════════════════════════════════════════════════════════════════════════
// DATA EXPORTS
// ═══════════════════════════════════════════════════════════════════════════════

plot(normalizedScore, title="Score (Raw)", display=display.none)
plot(waveValue, title="Wave Value", display=display.none)
plot(oscUpperBand, title="Upper Band Value", display=display.none)
plot(oscLowerBand, title="Lower Band Value", display=display.none)
plot(volatilityRatio, title="Volatility Ratio", display=display.none)
plot(bullCount, title="Bull Count", display=display.none)
plot(bearCount, title="Bear Count", display=display.none)
